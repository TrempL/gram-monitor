[Unit]
Description=GRAM Monitor (Flask + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=daniil
Group=daniil
WorkingDirectory=/home/daniil/gram-monitor
# Необязательно: сюда можно положить COINGECKO_API_KEY=...
EnvironmentFile=-/home/daniil/gram-monitor/.env
# 1 воркер (общий кэш, мало памяти) + 4 потока на запросы
ExecStart=/home/daniil/gram-monitor/.venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:8000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
